<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.8</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.vell27w</groupId>
	<artifactId>mall</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>mall</name>
	<description>单体电商后端 —— 商品 / 购物车 / 订单</description>
	<properties>
		<java.version>21</java.version>
	</properties>
	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!--
			参数校验（@Valid / @NotBlank / @NotNull ...）。
			注意坐标是 spring-boot-starter-validation，不是 webmvc。
			Boot 4 把 web 相关的 starter 改名成了 spring-boot-starter-webmvc
			（见上面的依赖），但 validation 这个还是老名字。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter</artifactId>
			<version>4.0.1</version>
		</dependency>

		<!--
			接口文档（Swagger UI）。
			【为什么是 3.0.3 而不是最新的 3.1.1？】
			看 springdoc 自己的父 pom 用的是哪个 Boot 版本编译的：
			    3.0.0 → Boot 4.0.0
			    3.0.3 → Boot 4.0.5   ← 本项目的 4.0.8 在这条线上
			    3.1.0 → Boot 4.1.0
			    3.1.1 → Boot 4.1.0
			3.1.x 是对着 Boot 4.1 编的。跨 minor 升库的风险是
			NoSuchMethodError —— 编译能过（方法签名在），运行时才炸，
			而且炸在启动那一刻，最难排查。
			选同 minor 线的最新版，这条规则对 MyBatis 也适用（选的 4.0.1 不是 4.1.0）。
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>3.0.3</version>
		</dependency>

		<!--
			Actuator：暴露 /actuator/health 等端点。
			两个用处：① docker-compose 里拿它做健康检查
			② 面试问「怎么知道服务活着」时有话可说。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
			Redis（后面做缓存和登录态时用）。Boot 4 官方坐标，客户端仍是 Lettuce，配置前缀没变。

			⚠️ 加了这个依赖后，本机没装 Redis 时应用**仍然能启动** ——
			Lettuce 是懒连接，第一次真正用的时候才建连接。
			这一点待真正用到 Redis 时实测确认。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-redis</artifactId>
		</dependency>

		<!--
			RabbitMQ（后面做超时关单时用）。

			【为什么不是 RocketMQ？】
			rocketmq-spring-boot-starter 最新 2.3.6，父 pom 还是 Boot 2.7.18 + Jackson 2，
			全项目没提过 Boot 4 —— 不是「还没适配」，是它的依赖树跟 Boot 4 冲突。
			RabbitMQ 官方 starter 跟着 Boot BOM 走，Boot 4 直接支持。
			另外面经里中小厂问 RabbitMQ 的比问 RocketMQ 的多。
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-amqp</artifactId>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.mybatis.spring.boot</groupId>
			<artifactId>mybatis-spring-boot-starter-test</artifactId>
			<version>4.0.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
